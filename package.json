{
  "name": "@ducflair/scopture-plugin",
  "version": "0.0.0-development",
  "private": true,
  "scripts": {
    "validate": "python3 scripts/validate_skills.py && python3 scripts/validate_plugins.py",
    "validate:skills": "python3 scripts/validate_skills.py",
    "validate:plugins": "python3 scripts/validate_plugins.py",
    "check:docs": "python3 scripts/check_docs.py",
    "package": "python3 scripts/package_release.py",
    "publish:mcp": "python3 scripts/publish_mcp_registry.py",
    "remote-docs": "python3 scripts/fetch_docs.py --to-skills --target all",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@semantic-release/exec": "^6.0.3",
    "semantic-release": "^24.2.0",
    "sharp": "^0.35.5"
  }
}
